# Supabase project settings → API (or "Connect" button)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The PUBLIC anon / publishable key. Never put the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Only for GitHub Pages project sites, e.g. /hydrate/  (leave unset for local dev / Vercel)
# VITE_BASE_PATH=/hydrate/
